// LolMobil relay (remote access) for Cloudflare Workers, free plan.
// Deploy: `npx wrangler deploy` from the repository root, or the
// "Deploy to Cloudflare" button in the README. See relay/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lolmobil-relay",
  "main": "relay/src/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": false }
}
